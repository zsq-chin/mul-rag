# .env.example -- Environment variable template for the platform.
# Copy to .env and fill in values before running docker compose.
# NEVER commit a populated .env file.

# --- Database secrets --------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- Object storage secrets --------------------------------------------------
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Application secrets -----------------------------------------------------
# JWT signing key for authentication tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=

# Master key for encrypting per-user model credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MODEL_CREDENTIAL_MASTER_KEY=

# Shared token for graph worker <-> API internal import endpoint (generate with: python -c "import secrets; print(secrets.token_hex(32))")
GRAPH_INTERNAL_TOKEN=

# --- External API keys -------------------------------------------------------
# Bocha web search API key (optional, leave empty to disable web search)
BOCHA_API_KEY=

# --- Network URLs ------------------------------------------------------------
# Multimodal knowledge base API (required for multimodal retrieval)
MULTIMODAL_KB_API_BASE=http://10.16.33.2:8002/api/v1
MULTIMODAL_KB_DEFAULT_KB_ID=
MULTIMODAL_KB_TIMEOUT=30
MULTIMODAL_KB_TOP_K=5

# Graph worker URL (default matches docker-compose service name)
GRAPH_WORKER_URL=http://graphrag-worker:8111

# Tianshu backend API base (default matches docker-compose service name)
TIANSHU_API_BASE=http://tianshu-backend:8000/api/v1

# --- User model security -----------------------------------------------------
# Comma-separated hostnames allowed for user-configured model endpoints
# (empty = reject all private/loopback IPs; set to e.g. "api.openai.com")
USER_MODEL_ALLOWED_HOSTS=
USER_MODEL_ALLOW_HTTP=false

# --- Concurrency limits ------------------------------------------------------
# Blocking thread pool size
BLOCKING_WORKERS=8

# Max concurrent chat streaming requests
CHAT_CONCURRENCY=2

# Max concurrent retrieval (Milvus/Neo4j) calls
RETRIEVAL_CONCURRENCY=4

# Max concurrent graph imports (Neo4j writes)
GRAPH_IMPORT_CONCURRENCY=1

# Max concurrent upstream proxy requests (multimodal/graph worker)
UPSTREAM_PROXY_CONCURRENCY=16

# Seconds to wait for a gate slot before returning 503
CONCURRENCY_ACQUIRE_TIMEOUT=30

# --- HTTP client timeouts (seconds) ------------------------------------------
# Multimodal HTTP client
MULTIMODAL_HTTP_CONNECT_TIMEOUT=10
MULTIMODAL_HTTP_READ_TIMEOUT=600
MULTIMODAL_HTTP_WRITE_TIMEOUT=60
MULTIMODAL_HTTP_POOL_TIMEOUT=10
MULTIMODAL_HTTP_MAX_CONNECTIONS=40
MULTIMODAL_HTTP_MAX_KEEPALIVE=20
MULTIMODAL_HTTP_KEEPALIVE_EXPIRY=30

# Graph worker HTTP client
GRAPH_WORKER_CONNECT_TIMEOUT=5
GRAPH_WORKER_READ_TIMEOUT=30
GRAPH_WORKER_WRITE_TIMEOUT=10
GRAPH_WORKER_POOL_TIMEOUT=5
GRAPH_WORKER_MAX_CONNECTIONS=10
GRAPH_WORKER_MAX_KEEPALIVE=5

# Tianshu backend HTTP client
TIANSHU_CONNECT_TIMEOUT=10
TIANSHU_READ_TIMEOUT=60

# --- Graph pipeline ----------------------------------------------------------
# Timeout in seconds for graph import operations
GRAPH_IMPORT_TIMEOUT=1800

# --- Model directory ---------------------------------------------------------
# Host path to model weights directory
MODEL_DIR=./models

# --- Web ---------------------------------------------------------------------
# Host port for the web frontend (production)
WEB_PORT=80
