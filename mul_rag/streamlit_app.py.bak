import streamlit as st
import requests
import json
import time
import os
import re
import pandas as pd
import urllib.parse
import base64

# 设置页面配置
st.set_page_config(
    page_title="多模态 RAG 系统 (Python版)",
    page_icon="🤖",
    layout="wide"
)

# 初始化 Session State
if "messages" not in st.session_state:
    st.session_state.messages = []
if "kb_id" not in st.session_state:
    st.session_state.kb_id = None
if "file_id" not in st.session_state:
    st.session_state.file_id = None
if "session_id" not in st.session_state:
    st.session_state.session_id = f"sess_{int(time.time())}"
if "parsing_status" not in st.session_state:
    st.session_state.parsing_status = "idle"

# Sidebar 配置
with st.sidebar:
    api_base = "http://202.204.194.41:8001/api/v1"

    st.subheader("📚 知识库")

    # 1) 拉取知识库列表
    kb_items = []
    try:
        kb_resp = requests.get(f"{api_base}/kb/list", timeout=10)
        if kb_resp.status_code == 200:
            kb_items = kb_resp.json().get("kbs", [])
        else:
            st.warning("无法获取知识库列表")
    except Exception as e:
        st.warning(f"连接错误: {e}")

    # 2) 新建知识库
    new_kb_name = st.text_input("新建知识库名称(必填)", value="")

    # 仅做 UI 选择：后端会把配置写入 KB 元数据
    embed_model = st.text_input("向量模型 (embedModel)", value="bge-m3:latest")
    vector_store_type = st.selectbox(
            "向量库类型 (vectorStoreType)",
            options=["faiss", "milvus", "es"],
            index=0,
            help="faiss: 本地索引; milvus/es: 需在后端安装依赖并配置连接(环境变量)。",
        )
    if st.button("新建知识库"):
        try:
            resp = requests.post(
                f"{api_base}/kb/create",
                json={
                    "kbName": new_kb_name,
                    "embedModel": embed_model,
                    "vectorStoreType": vector_store_type,
                },
                timeout=20,
            )
            if resp.status_code == 200:
                data = resp.json()
                st.session_state.kb_id = data.get("kbId")
                st.session_state.file_id = None
                st.session_state.parsing_status = "idle"
                st.success(f"已创建知识库: {data.get('kbName')} (ID: {data.get('kbId')})")
            else:
                st.error(f"创建失败: {resp.text}")
        except Exception as e:
            st.error(f"创建失败: {e}")

    # 3) 选择知识库
    options = ["-- 请选择 --"]
    kb_map = {}
    for it in kb_items:
        kb_id = it.get("kbId")
        kb_name = it.get("kbName") or kb_id
        label = f"{kb_name}  ({kb_id})"
        options.append(label)
        kb_map[label] = kb_id

    selected_label = st.selectbox("选择知识库", options)
    if selected_label != "-- 请选择 --":
        selected_kb_id = kb_map.get(selected_label)
        if selected_kb_id and st.session_state.kb_id != selected_kb_id:
            st.session_state.kb_id = selected_kb_id
            st.session_state.file_id = None
            st.session_state.parsing_status = "idle"
            st.session_state.messages = []
            st.success(f"已切换到知识库: {selected_kb_id}")

    # 4) 选择知识库内文件
    kb_files = []
    if st.session_state.kb_id:
        try:
            r = requests.get(f"{api_base}/kb/files", params={"kbId": st.session_state.kb_id}, timeout=10)
            if r.status_code == 200:
                kb_files = r.json().get("files", [])
        except Exception:
            kb_files = []

    file_options = ["-- 不选择文件 --"]
    file_map = {}
    for f in kb_files:
        fid = f.get("fileId")
        fname = f.get("fileName") or fid
        label = f"{fname}  ({fid})"
        file_options.append(label)
        file_map[label] = fid

    selected_file_label = st.selectbox("选择文件 (可选)", file_options)
    if selected_file_label != "-- 不选择文件 --":
        fid = file_map.get(selected_file_label)
        if fid and st.session_state.file_id != fid:
            st.session_state.file_id = fid
            st.session_state.parsing_status = "idle"

    st.divider()
    
    uploaded_file = st.file_uploader("上传文档 (PDF, Excel, CSV)", type=["pdf", "xlsx", "xls", "csv"], help="点击浏览或拖拽文件上传")
    
    # 新增：解析方法选择
    parse_method_map = {"original": "基础解析 (Original)", "olmocr": "增强解析 (OlmOCR)"}
    parse_method = st.radio(
        "解析方法", 
        ["original", "olmocr"], 
        format_func=lambda x: parse_method_map[x],
        captions=["传统方法 (Unstructured + PaddleOCR)", "多模态大模型 (OlmOCR)"]
    )

    if uploaded_file:
        if st.button("上传并解析"):
            with st.spinner("正在上传..."):
                try:
                    if not st.session_state.kb_id:
                        st.error("请先在上方选择或新建一个知识库")
                        st.stop()

                    # Determine mime type
                    mime_type = "application/octet-stream"
                    if uploaded_file.name.endswith(".pdf"):
                        mime_type = "application/pdf"
                    elif uploaded_file.name.endswith(".xlsx"):
                        mime_type = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                    elif uploaded_file.name.endswith(".xls"):
                        mime_type = "application/vnd.ms-excel"
                    elif uploaded_file.name.endswith(".csv"):
                        mime_type = "text/csv"
                        
                    files = {"file": (uploaded_file.name, uploaded_file, mime_type)}
                    resp = requests.post(
                        f"{api_base}/pdf/upload",
                        files=files,
                        data={"kbId": st.session_state.kb_id},
                        timeout=120,
                    )
                    if resp.status_code == 200:
                        data = resp.json()
                        st.session_state.kb_id = data.get("kbId") or st.session_state.kb_id
                        st.session_state.file_id = data["fileId"]
                        st.success(f"上传成功! File ID: {data['fileId']}")
                        
                        # 触发解析
                        parse_resp = requests.post(f"{api_base}/pdf/parse", json={
                            "kbId": st.session_state.kb_id,
                            "fileId": st.session_state.file_id,
                            "method": parse_method
                        })
                        if parse_resp.status_code == 200:
                            st.session_state.parsing_status = "parsing"
                            st.info(f"解析任务已提交 (方法: {parse_method})...")
                        else:
                            st.error(f"解析请求失败: {parse_resp.text}")
                    else:
                        st.error(f"上传失败: {resp.text}")
                except Exception as e:
                    st.error(f"发生错误: {e}")

    # 状态轮询与索引构建
    if st.session_state.kb_id:
        st.markdown(f"**当前知识库 ID:** `{st.session_state.kb_id}`")

    if st.session_state.kb_id and st.session_state.file_id:
        st.markdown(f"**当前文件 ID:** `{st.session_state.file_id}`")
        
        if st.button("刷新状态"):
            try:
                status_resp = requests.get(
                    f"{api_base}/pdf/status",
                    params={"kbId": st.session_state.kb_id, "fileId": st.session_state.file_id},
                )
                if status_resp.status_code == 200:
                    status_data = status_resp.json()
                    st.session_state.parsing_status = status_data["status"]
                    progress = status_data.get("progress", 0)
                    st.progress(progress / 100)
                    st.write(f"状态: {status_data['status']}")
                else:
                    st.error("获取状态失败")
            except Exception as e:
                st.error(f"连接错误: {e}")

        if st.session_state.parsing_status == "ready":
            if st.button("构建索引 (Build Index)"):
                with st.spinner("正在构建索引..."):
                    try:
                        idx_resp = requests.post(
                            f"{api_base}/index/build",
                            json={"kbId": st.session_state.kb_id, "fileId": st.session_state.file_id},
                        )
                        if idx_resp.status_code == 200:
                            st.success("索引构建成功！现在可以开始对话了。")
                        else:
                            st.error(f"索引构建失败: {idx_resp.text}")
                    except Exception as e:
                        st.error(f"错误: {e}")

# 主界面 Tabs
tab4, tab5 = st.tabs(["🔍 多模态搜索", "📚 知识库预览"])
#tab1, tab2, tab3, tab4, tab5 = st.tabs(["💬 对话", "📄 文档查看", "🖼️ 提取图片", "🔍 调试搜索", "📚 知识库预览"])
