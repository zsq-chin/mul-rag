# 远端多模态 RAG 后端运行变量模板（I3.4）。
# 复制为 /etc/multimodal-rag.env 并填真实值；该文件属于部署机秘密，绝不入库。
# 与 docker-compose.yml 中 rag-backend 服务的环境变量保持一致。

# 时区
TZ=Asia/Shanghai

# 本地模型服务地址（Ollama）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434

# 专用 OCR 服务地址（本地调试/自建时填写；生产请改为部署机实际可达地址）
OLM_OCR_ENDPOINT=http://olmocr:8005/v1/chat/completions

# 可选：远端服务间认证 Token（与 SAGE 侧 MULTIMODAL_SERVICE_TOKEN 对应）
# MULTIMODAL_SERVICE_TOKEN=

# 可选：覆盖监听地址/端口（默认 0.0.0.0:8002）
# MULTIMODAL_BIND=0.0.0.0
# MULTIMODAL_PORT=8002
